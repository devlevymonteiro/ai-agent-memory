; Engine configuration file.
; Build mobile: renderer mobile + VRAM ETC2/ASTC + sombra 1024 + VSync 60.

config_version=5

[application]

config/name="Xadrez 3D"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
run/max_fps=60

[display]

window/handheld/orientation=0
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="squares"
3d_physics/layer_2="pieces"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_2d=0
lights_and_shadows/directional_shadow/atlas_size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/directional_shadow/blend_splits=false
environment/defaults/default_clear_color=Color(0.0784314, 0.0862745, 0.117647, 1)
